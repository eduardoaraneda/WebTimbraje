@{
    ViewData["Title"] = "Timbraje de Documento";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-receipt-cutoff me-2"></i>
                    Timbraje de Documento
                </h5>
            </div>
            <div class="card-body">
                <form id="formTimbraje" asp-controller="Timbraje" asp-action="Timbrar" method="post">
                    <div class="mb-3">
                        <label class="form-label">Empresa</label>
                        <select name="empresa" class="form-select" required>
                            <option value="">Seleccione empresa</option>
                            <option value="Comercializadora">Comercializadora</option>
                            <option value="HIT SA">HIT</option>
                            <option value="International">The Line</option>
                            <option value="ANDPAC">ANDPAC</option>
                            <option value="Tecnobuy">Tecnobuy</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo Documento</label>
                        <select name="tipo" class="form-select" required>
                            <option value="">Seleccione tipo</option>
                            <option value="BLE">BLE</option>
                            <option value="GDV">GDV</option>
                            <option value="FCV">FCV</option>
                            <option value="NCV">NCV</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Número de Documento</label>
                        <input type="number"
                               name="numero"
                               class="form-control"
                               placeholder="Ingrese el número de documento"
                               required />
                    </div>

                    <div class="d-grid">
                        <button id="btnTimbrar" type="submit" class="btn btn-success">
                            <i class="bi bi-send-check me-1"></i>
                            Timbrar Documento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-3">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    Resultado
                </h5>
            </div>
            <div class="card-body">
                <div class="mt-2">
                    <label for="txtRespuesta" class="form-label">Respuesta</label>
                    <textarea id="txtRespuesta"
                              class="form-control"
                              rows="3"
                              readonly
                              ></textarea>
                </div>

                <div class="mt-3">
                    <label for="txtUrl" class="form-label">URL</label>
                    <input id="txtUrl"
                           type="text"
                           class="form-control"
                           readonly
                           placeholder="URL del documento" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("formTimbraje").addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const btn = document.getElementById("btnTimbrar");
            const txtRespuesta = document.getElementById("txtRespuesta");
            const txtUrl = document.getElementById("txtUrl");

            txtRespuesta.value = "";
            txtUrl.value = "";

            txtRespuesta.classList.remove("is-valid", "is-invalid");
            txtUrl.classList.remove("is-valid", "is-invalid");

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Procesando...';

            try {
                const formData = new FormData(form);

                const response = await fetch(form.action, {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();
                console.log(result);
                if (!result.success) {
                    txtRespuesta.value = result.message || "Ocurrió un error al timbrar el documento.";
                    txtUrl.value = "";
                    txtRespuesta.classList.add("is-invalid");
                    return;
                }

                let mensajeFinal = "Documento timbrado correctamente";
                let urlFinal = "";

                if (result.resultado) {
                    if (result.resultado.Mensaje && result.resultado.Mensaje.trim() !== "") {
                        mensajeFinal += " - " + result.resultado.Mensaje;
                    }

                    if (result.resultado.data.urlDTE && result.resultado.data.urlDTE.trim() !== "") {
                        urlFinal = result.resultado.data.urlDTE;
                    }
                    else if (result.resultado.UrlDTE && result.resultado.UrlDTE.trim() !== "") {
                        urlFinal = result.resultado.UrlDTE;
                    }
                    else if (result.resultado.DTEpdf && result.resultado.DTEpdf.trim() !== "") {
                        urlFinal = result.resultado.DTEpdf;
                    }
                }

                if (urlFinal !== "") {
                    mensajeFinal += " - URL generada correctamente";
                }

                txtRespuesta.value = mensajeFinal;
                txtUrl.value = urlFinal;

                txtRespuesta.classList.add("is-valid");
                if (urlFinal !== "") {
                    txtUrl.classList.add("is-valid");
                }
            }
            catch (error) {
                txtRespuesta.value = "Error inesperado al procesar la solicitud.";
                txtUrl.value = "";
                txtRespuesta.classList.add("is-invalid");
                console.error(error);
            }
            finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-check me-1"></i>Timbrar Documento';
            }
        });
    </script>
}